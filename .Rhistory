bicres<-read.csv("bicres.csv")
modelsToRun.sp<-list()
spToDo<-read.csv("spToDo.csv")
for(i in 1:nrow(spToDo)) {
modelsToRun.sp[[i]]<-paste("y ~",bicres$formula[bicres$ColName==spToDo$ColName[i]])
}
names(modelsToRun.sp)<-spToDo$ColName
modelsToRun.sp
#Test 1/2
runNum<-1
setupObj<-loadOutputs(runName=spToDo$ModAreaNum[runNum],
runDate="2025-12-31",
modelScenarios = "m3")$setupObj
stanSumObj<-bycatchStanSim(setupObj = setupObj,
modelsToRun = modelsToRun.sp[runNum],
spNum = spToDo$SpNum[runNum],
stanModel = "nbinom2",
priors = list(interceptSD = 4,
coefficientSD = 1,
phiType = c("exponential","normal")[1],
phiPar = 1,
RanEffPar = 1),
modeledEffort = TRUE,
effortSD = "hoursSD",
useCode = "cmdstanr"
)
